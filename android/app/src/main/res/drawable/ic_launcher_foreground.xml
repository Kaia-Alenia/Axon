<?xml version="1.0" encoding="utf-8"?>
<!-- Axon launcher icon foreground: new neuron-mouse logo (docs/axon-logo.svg).
     Gradient rounded-square background with the dark-navy mouse and neuron
     branches. Keep in sync with docs/axon-logo.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Gradient rounded-square background (#22D3EE -> #A78BFA) -->
    <path
        android:pathData="M112,0 L400,0 A112,112 0 0 1 512,112 L512,400 A112,112 0 0 1 400,512 L112,512 A112,112 0 0 1 0,400 L0,112 A112,112 0 0 1 112,0 Z">
        <gradient
            android:type="linear"
            android:startX="0"
            android:startY="0"
            android:endX="512"
            android:endY="0"
            android:startColor="#22D3EE"
            android:endColor="#A78BFA" />
    </path>

    <group android:translateY="15">
        <!-- Mouse body -->
        <path
            android:pathData="M96,265 A75,75 0 0 1 246,265 L246,365 A75,75 0 0 1 96,365 Z"
            android:strokeWidth="30"
            android:strokeColor="#0B1226"
            android:strokeLineJoin="round" />
        <!-- Mouse divider and stem -->
        <path
            android:pathData="M98,307 H244 M171,192 V307"
            android:strokeWidth="14"
            android:strokeColor="#0B1226"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Neuron branch -->
        <path
            android:pathData="M171,188 V150 C171,104 205,86 260,86 H310"
            android:strokeWidth="20"
            android:strokeColor="#0B1226"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Branch tips -->
        <path
            android:pathData="M310,86 L392,52 M310,86 L404,118 M310,86 L360,176"
            android:strokeWidth="16"
            android:strokeColor="#0B1226"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Neuron nodes -->
        <path
            android:pathData="M392,52 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
            android:fillColor="#0B1226" />
        <path
            android:pathData="M404,118 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
            android:fillColor="#0B1226" />
        <path
            android:pathData="M360,176 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
            android:fillColor="#0B1226" />
        <!-- Scroll wheel -->
        <path
            android:pathData="M156,239 A15,15 0 0 1 186,239 L186,265 A15,15 0 0 1 156,265 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
